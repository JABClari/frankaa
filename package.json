{
  "name": "frankaa",
  "version": "0.3.0",
  "description": "A photo slider that follows the finger and a lightbox that unfurls each photo from its spot, with WebGL shader effects or a CSS fallback. Framework-free TypeScript, zero dependencies, thin React bindings.",
  "license": "MIT",
  "author": "Joshua, Sirius Arc",
  "homepage": "https://jabclari.github.io/frankaa/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JABClari/frankaa.git"
  },
  "bugs": {
    "url": "https://github.com/JABClari/frankaa/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/chunks/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./slider": {
      "types": "./dist/slider.d.ts",
      "import": "./dist/slider.js"
    },
    "./lightbox": {
      "types": "./dist/lightbox.d.ts",
      "import": "./dist/lightbox.js"
    },
    "./drumline": {
      "types": "./dist/drumline.d.ts",
      "import": "./dist/drumline.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt",
    "llms-full.txt",
    "AGENTS.md",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "check:keys": "node scripts/check-keys.mjs",
    "check:touch": "node scripts/check-touch.mjs",
    "check:perf": "node scripts/check-perf.mjs",
    "pretest": "npm run build",
    "check:features": "node scripts/check-features.mjs",
    "check:drumline": "node scripts/check-drumline.mjs"
  },
  "keywords": [
    "slider",
    "carousel",
    "scroll-snap",
    "lightbox",
    "gallery",
    "photos",
    "webgl",
    "shader",
    "glsl",
    "transition",
    "flip",
    "react",
    "nextjs",
    "typescript",
    "accessible",
    "a11y",
    "reduced-motion",
    "zero-dependency",
    "llms-txt",
    "ai-ready",
    "ruler",
    "stories",
    "scrubber"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
